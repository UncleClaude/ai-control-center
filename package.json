{
  "name": "ai-control-center",
  "productName": "AI Control Center",
  "desktopName": "ai-control-center.desktop",
  "version": "0.1.0",
  "description": "Desktop app gathering Muse, Claude and ChatGPT web apps in one glass window.",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:inspect": "electron-vite dev --remoteDebuggingPort 9333",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "44.11.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "allowScripts": {
    "electron@44.11.2": true,
    "electron-winstaller": false
  }
}
